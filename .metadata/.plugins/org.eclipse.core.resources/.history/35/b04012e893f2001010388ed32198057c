package GameEnginePackage;
import org.joml.Matrix4f;

import GameEnginePackage.entity.Camera;
import GameEnginePackage.entity.Light;
import GameEnginePackage.entity.Shader;
import GameEnginePackage.utils.Maths;

public class ShaderManager extends Shader{
	private static final String VERTEX_SHADER = 
			"src/shaders/vertexShader.txt";
	private static final String FRAGMENT_SHADER = 
			"src/shaders/fragmentShader.txt";
	
	private int location_transformationMatrix;
	private int location_prevTransformationMatrix;
	
	private int location_projectionMatrix;
	private int location_prevProjectionMatrix;
	
	private int location_viewMatrix;
	private int location_prevView;
	
	private int location_lightPosition;
	private int location_lightColor;
	private int location_shineDamper;
	private int location_reflectivity;
	
	public ShaderManager() {
		super(VERTEX_SHADER, FRAGMENT_SHADER);
		// TODO Auto-generated constructor stub
	}

	@Override
	protected void bindAttributes() {
		// TODO Auto-generated method stub
		super.bindAttribute(0, "position");
		super.bindAttribute(1, "textureCoords");
		super.bindAttribute(2, "normal");
	}

	@Override
	protected void getAllUniformLocations() {
		// TODO Auto-generated method stub
		location_transformationMatrix = 
				super.getUniformLocation("transformationMatrix");
		location_prevTransformationMatrix = 
				super.getUniformLocation("prevTransformationMatrix");
		
		location_projectionMatrix = 
				super.getUniformLocation("projectionMatrix");
		location_prevProjectionMatrix =
				super.getUniformLocation("prevProjectionMatrix");
		
		location_viewMatrix = 
				super.getUniformLocation("viewMatrix");
		location_prevView = 
				super.getUniformLocation("prevView");
		
		location_lightPosition =
				super.getUniformLocation("lightPosition");
		location_lightColor = 
				super.getUniformLocation("lightColor");
		location_shineDamper = 
				super.getUniformLocation("shineDamper");
		location_reflectivity = 
				super.getUniformLocation("reflectivity");
	}
	
	public void loadShineVariables(float damper, float reflectivity) {
		super.loadFloat(location_shineDamper, damper);
		super.loadFloat(location_reflectivity, reflectivity);
		
	}
	
	public void loadTransformationMatrix(Matrix4f matrix) {
		super.loadMatrix(location_transformationMatrix, matrix);
	}
	
	public void loadPrevTransformationMatrix(Matrix4f matrix) {
		super.loadMatrix(location_prevTransformationMatrix, matrix);
	}
	
	public void loadViewMatrix(Camera camera) {
		Matrix4f viewMatrix = Maths.createViewMatrix(camera);
		super.loadMatrix(location_viewMatrix, viewMatrix);
	}
	
	public void loadPrevView(Camera camera) {
		Matrix4f prevView = Maths.createViewMatrix(camera);
		super.loadMatrix(location_prevView, prevView);
	}
	
	public void loadProjectionMatrix(Matrix4f projection) {
		super.loadMatrix(location_projectionMatrix, projection);
	}
	
	public void loadPrevProjectionMatrix(Matrix4f projection) {
		super.loadMatrix(location_prevProjectionMatrix, projection);
	}
	
	public void loadLight(Light light) {
		super.loadVector(location_lightPosition, light.getPosition());
		super.loadVector(location_lightColor, light.getColor());
	}
}
