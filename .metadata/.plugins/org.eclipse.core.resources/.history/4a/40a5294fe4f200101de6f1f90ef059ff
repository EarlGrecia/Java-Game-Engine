package GameEnginePackage.entity;

public class BlurShader extends Shader {
	private static final String BLUR_VERTEX = "src/shaders/blurVertex.txt";
	private static final String BLUR_FRAGMENT = "src/shaders/blur.txt";
	
	private int location_velocityScale;
	private int location_nSamples;
	
	public BlurShader() {
		super(BLUR_VERTEX, BLUR_FRAGMENT);
	}

	@Override
	protected void getAllUniformLocations() {
		// TODO Auto-generated method stub
		location_velocityScale = 
				super.getUniformLocation("uVelocityScale");
		location_nSamples = 
				super.getUniformLocation("nSamples");
	}
	
	public void loadVelocityScale(float uVelocityScale) {
		super.loadFloat(location_velocityScale, uVelocityScale);
	}
	
	public void loadSamples(int nSamples) {
		super.loadInt(location_nSamples, nSamples);
	}

	@Override
	protected void bindAttributes() {
		// TODO Auto-generated method stub
		super.bindAttribute(0, "positions");
		super.bindAttribute(1, "texCoords");
		
	}
}
